# Токен бота от @BotFather (обязательно)
BOT_TOKEN=
# ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=
# Необязательно: ID группы персонала для уведомлений (иначе — в личку админам)
ADMIN_CHAT_ID=
# 1 — демо-режим: команда /demo_admin делает отправителя администратором
DEMO_MODE=1
TZ_NAME=Europe/Kirov
# Необязательно: ключ Anthropic для ИИ-консультанта (без него вопросы уходят администратору)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
